ends_with("pre_mr_ldiff_code"),
~ . == "CORRECT",
.names = "correct_{col}"),
na.rm = TRUE),
post_correct = rowMeans(across(ends_with("post_km_code") |
ends_with("post_survdiff_code") |
ends_with("post_mrl_code") |
ends_with("post_mr_ldiff_code"),
~ . == "CORRECT",
.names = "correct_{col}"),
na.rm = TRUE)
)
